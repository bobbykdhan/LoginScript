# Copy to .env and fill in. Keep .env private: it holds your Steam password.
#
# The container only logs in to Steam when the game is not installed yet or
# FORCE_STEAMCMD_UPDATE=true. After the first successful start you can blank
# STEAM_PASS and set it again only when you want to update the game.

STEAM_USER=your_steam_login
STEAM_PASS=your_steam_password
# Steam Guard code from your email/app, needed on the first login only.
STEAM_GUARD=

# mono (Steam "alternate" branch) or il2cpp (normal branch).
S1DS_RUNTIME=mono

# Optional: override the Steam branch picked from S1DS_RUNTIME.
STEAM_BRANCH=

# Set to true for one start to download a game update, then back to false.
FORCE_STEAMCMD_UPDATE=false

# Pin the server image to a release tag.
S1DS_IMAGE=ghcr.io/ifbars/s1dedicatedservers:1.1.6
